# Test-only Functions Emulator configuration. No secrets and never deployed.
# Firebase CLI may spawn a child process during function discovery that does
# not inherit the command-line emulator host environment consistently.
# See Firebase documentation: .env.local is loaded only by the emulator.
HYBRID_DEMO_FUNCTIONS_ONLY=1
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
