rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function authenticated() {
      return request.auth != null;
    }

    function customerContext() {
      return authenticated()
        && request.auth.uid.matches('cust_.*')
        && request.auth.token.get('customerContext', false) == true
        && request.auth.token.get('customerGoogle', false) == true;
    }

    function signedIn() {
      return authenticated() && !customerContext();
    }

    function staffProfile() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    function hasRole(roles) {
      return signedIn()
        && staffProfile().active == true
        && staffProfile().role in roles;
    }

    function adminRole() {
      return hasRole(['owner', 'admin', 'super_admin']);
    }

    function staffRole() {
      return hasRole(['owner', 'admin', 'super_admin', 'cashier', 'kitchen']);
    }

    function validImage(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    function validRevenueShareSlip(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && (request.resource.contentType.matches('image/(jpeg|png|webp)')
          || request.resource.contentType == 'application/pdf');
    }

    function tenantOwner(tenantId) {
      return signedIn()
        && (
          firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid
          || firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data.ownerEmail == request.auth.token.email
        );
    }

    function userTenantProductAdmin(tenantId) {
      return signedIn()
        && staffProfile().active == true
        && staffProfile().tenantId == tenantId
        && staffProfile().role in ['owner', 'admin', 'manager', 'super_admin'];
    }

    function membershipTenantProductAdmin(tenantId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/tenants/$(tenantId)/memberships/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/tenants/$(tenantId)/memberships/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/tenants/$(tenantId)/memberships/$(request.auth.uid)).data.role in ['owner', 'admin', 'manager', 'super_admin'];
    }

    function tenantProductAdmin(tenantId) {
      return tenantOwner(tenantId)
        || userTenantProductAdmin(tenantId)
        || membershipTenantProductAdmin(tenantId);
    }

    match /platform-branding/{fileName} {
      allow read: if true;
      allow create, update: if hasRole(['super_admin']) && validImage(4 * 1024 * 1024);
      allow delete: if hasRole(['super_admin']);
    }

    match /menu-images/{menuId}/{fileName} {
      allow read: if true;
      allow create, update: if adminRole() && validImage(8 * 1024 * 1024);
      allow delete: if adminRole();
    }

    match /tenants/{tenantId}/product-images/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if tenantProductAdmin(tenantId) && validImage(5 * 1024 * 1024);
      allow delete: if tenantProductAdmin(tenantId);
    }

    match /tenants/{tenantId}/lalamove-wallet-topups/{topupId}/{fileName} {
      allow read: if hasRole(['super_admin']) || tenantProductAdmin(tenantId);
      allow create, update: if tenantProductAdmin(tenantId) && validRevenueShareSlip(10 * 1024 * 1024);
      allow delete: if tenantProductAdmin(tenantId);
    }

    match /payment-slips/{orderId}/{fileName} {
      allow create: if validImage(8 * 1024 * 1024);
      allow read: if staffRole();
      allow update: if false;
      allow delete: if hasRole(['owner', 'super_admin']);
    }

    match /tenants/{tenantId}/payment-slips/{orderId}/{fileName} {
      allow create: if validImage(8 * 1024 * 1024);
      allow read: if staffRole();
      allow update: if false;
      allow delete: if hasRole(['owner', 'super_admin']);
    }

    match /tenants/{tenantId}/revenue-share-slips/{paymentId}/{fileName} {
      allow create: if tenantProductAdmin(tenantId) && validRevenueShareSlip(10 * 1024 * 1024);
      allow read: if hasRole(['super_admin']) || tenantProductAdmin(tenantId);
      allow update: if false;
      allow delete: if tenantProductAdmin(tenantId)
        && !firestore.exists(/databases/(default)/documents/tenants/$(tenantId)/revenueSharePayments/$(paymentId));
    }

    // Hybrid billing bank proof is write-once, staff-owned and private.
    // This is SOURCE ONLY until Auth + Storage emulator testing and release
    // review pass. An uploaded slip is never itself approval of an invoice.
    match /tenants/{tenantId}/hybrid-billing-slips/{attemptId}/{fileName} {
      // Explicit resource-null guard is needed: the Storage Emulator may
      // classify a same-path upload as create unless the precondition is set.
      allow create: if resource == null && signedIn()
        && staffProfile().active == true
        && staffProfile().tenantId == tenantId
        && staffProfile().role in ['owner', 'admin']
        && firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data.billingPolicyVersion == 'hybrid_v1'
        && request.resource.metadata.get('uploadedByUid', '') == request.auth.uid
        && validRevenueShareSlip(10 * 1024 * 1024);
      allow read: if hasRole(['super_admin'])
        || (signedIn() && staffProfile().active == true
          && staffProfile().tenantId == tenantId
          && staffProfile().role in ['owner', 'admin']);
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
