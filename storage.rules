rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function authenticated() {
      return request.auth != null;
    }

    function customerContext() {
      return authenticated()
        && request.auth.uid.matches('cust_.*')
        && request.auth.token.get('customerContext', false) == true
        && request.auth.token.get('customerGoogle', false) == true;
    }

    function signedIn() {
      return authenticated() && !customerContext();
    }

    function staffProfile() {
      return firestore.get(
        /databases/(default)/documents/users/$(request.auth.uid)
      ).data;
    }

    function hasRole(roles) {
      return signedIn()
        && staffProfile().active == true
        && staffProfile().role in roles;
    }

    function adminRole() {
      return hasRole(['owner', 'admin', 'super_admin']);
    }

    function staffRole() {
      return hasRole(['owner', 'admin', 'super_admin', 'cashier', 'kitchen']);
    }

    function validImage(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    function validRevenueShareSlip(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && (request.resource.contentType.matches('image/(jpeg|png|webp)')
          || request.resource.contentType == 'application/pdf');
    }

    function tenantOwner(tenantId) {
      let tenantPath = /databases/(default)/documents/tenants/$(tenantId);
      // ownerEmail is optional in modern tenant documents. Missing optional
      // fields must not trigger a Storage Rules evaluation exception.
      return signedIn()
        && firestore.exists(tenantPath)
        && (
          firestore.get(tenantPath).data.get('ownerUid', '') == request.auth.uid
          || (request.auth.token.get('email', '') != ''
            && firestore.get(tenantPath).data.get('ownerEmail', '') == request.auth.token.get('email', ''))
        );
    }

    function userTenantProductAdmin(tenantId) {
      return signedIn()
        && staffProfile().active == true
        && staffProfile().tenantId == tenantId
        && staffProfile().role in ['owner', 'admin', 'manager', 'super_admin'];
    }

    function membershipTenantProductAdmin(tenantId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/tenants/$(tenantId)/memberships/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/tenants/$(tenantId)/memberships/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/tenants/$(tenantId)/memberships/$(request.auth.uid)).data.role in ['owner', 'admin', 'manager', 'super_admin'];
    }

    function tenantProductAdmin(tenantId) {
      return tenantOwner(tenantId)
        || userTenantProductAdmin(tenantId)
        || membershipTenantProductAdmin(tenantId);
    }
    function tenantBillingAdmin(tenantId) {
      return hasRole(['super_admin'])
        || tenantOwner(tenantId)
        || (signedIn()
          && staffProfile().active == true
          && staffProfile().tenantId == tenantId
          && staffProfile().role in ['owner', 'admin']);
    }
    function hybridInvoiceAcceptsEvidence(tenantId, invoiceId) {
      let invoicePath = /databases/(default)/documents/tenants/$(tenantId)/hybridBillingInvoices/$(invoiceId);
      return firestore.exists(invoicePath)
        && firestore.get(invoicePath).data.get('status', '') in ['issued', 'rejected'];
    }
    // A short-lived server-only reservation is the *only* authority to upload.
    // The browser may not write/read the Firestore grant, choose another
    // filename, change the expected byte count, or upload as another tenant.
    function validHybridEvidenceGrant(tenantId, invoiceId, attemptId, fileName) {
      let grantPath = /databases/(default)/documents/tenants/$(tenantId)/hybridBillingUploadGrants/$(attemptId);
      let invoicePath = /databases/(default)/documents/tenants/$(tenantId)/hybridBillingInvoices/$(invoiceId);
      return signedIn()
        && firestore.exists(grantPath)
        && firestore.exists(invoicePath)
        && staffProfile().active == true
        && staffProfile().tenantId == tenantId
        && staffProfile().role in ['owner', 'admin']
        && firestore.get(grantPath).data.get('id', '') == attemptId
        && firestore.get(grantPath).data.get('tenantId', '') == tenantId
        && firestore.get(grantPath).data.get('invoiceId', '') == invoiceId
        && firestore.get(grantPath).data.get('actorUid', '') == request.auth.uid
        && firestore.get(grantPath).data.get('status', '') == 'reserved'
        && firestore.get(grantPath).data.get('expiresAt', request.time) > request.time
        && firestore.get(grantPath).data.get('invoiceSignature', '') == firestore.get(invoicePath).data.get('signature', '')
        && firestore.get(grantPath).data.get('slipPath', '') == 'tenants/' + tenantId + '/hybrid-billing-slips/' + invoiceId + '/' + attemptId + '/' + fileName
        && firestore.get(grantPath).data.get('contentType', '') == request.resource.contentType
        && firestore.get(grantPath).data.get('maxSize', 0) == request.resource.size;
    }

    match /platform-branding/{fileName} {
      allow read: if true;
      allow create, update: if hasRole(['super_admin']) && validImage(4 * 1024 * 1024);
      allow delete: if hasRole(['super_admin']);
    }

    match /menu-images/{menuId}/{fileName} {
      allow read: if true;
      allow create, update: if adminRole() && validImage(8 * 1024 * 1024);
      allow delete: if adminRole();
    }

    match /tenants/{tenantId}/product-images/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if tenantProductAdmin(tenantId) && validImage(5 * 1024 * 1024);
      allow delete: if tenantProductAdmin(tenantId);
    }

    match /tenants/{tenantId}/lalamove-wallet-topups/{topupId}/{fileName} {
      allow read: if hasRole(['super_admin']) || tenantProductAdmin(tenantId);
      allow create, update: if tenantProductAdmin(tenantId) && validRevenueShareSlip(10 * 1024 * 1024);
      allow delete: if tenantProductAdmin(tenantId);
    }

    match /payment-slips/{orderId}/{fileName} {
      allow create: if validImage(8 * 1024 * 1024);
      allow read: if staffRole();
      allow update: if false;
      allow delete: if hasRole(['owner', 'super_admin']);
    }

    match /tenants/{tenantId}/payment-slips/{orderId}/{fileName} {
      allow create: if validImage(8 * 1024 * 1024);
      allow read: if staffRole();
      allow update: if false;
      allow delete: if hasRole(['owner', 'super_admin']);
    }

    // Proof is scoped to exactly one invoice and one unique submission.
    // No browser may replace or delete a submitted banking record.
    match /tenants/{tenantId}/hybrid-billing-slips/{invoiceId}/{attemptId}/{fileName} {
      allow read: if tenantBillingAdmin(tenantId);
      // A second upload to the same Storage path may still be evaluated as
      // CREATE (Firebase Storage SDK/Emulator behavior). Explicitly require
      // that no object existed before this write; update:false alone is
      // insufficient to guarantee immutable bank evidence.
      allow create: if resource == null
        && validHybridEvidenceGrant(tenantId, invoiceId, attemptId, fileName)
        && hybridInvoiceAcceptsEvidence(tenantId, invoiceId)
        && invoiceId.matches('20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]:(delivery:.*|monthly:fixed)')
        && attemptId.matches('[A-Za-z0-9_-]{16,80}')
        && fileName.matches('[A-Za-z0-9_.-]{1,160}')
        && validRevenueShareSlip(10 * 1024 * 1024);
      allow update, delete: if false;
    }

    match /tenants/{tenantId}/revenue-share-slips/{paymentId}/{fileName} {
      allow create: if tenantProductAdmin(tenantId) && validRevenueShareSlip(10 * 1024 * 1024);
      allow read: if hasRole(['super_admin']) || tenantProductAdmin(tenantId);
      allow update: if false;
      allow delete: if tenantProductAdmin(tenantId)
        && !firestore.exists(/databases/(default)/documents/tenants/$(tenantId)/revenueSharePayments/$(paymentId));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
