<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lk_qr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E593F">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_preview_scaling_strategy="centerCrop"
        app:zxing_use_texture_view="false" />

    <com.lukkaja.companion.LKQRGuideOverlay
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="top"
        android:background="#0E593F"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/lk_qr_back"
            android:layout_width="55dp"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="ย้อนกลับ"
            android:src="@drawable/lk_qr_back"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/kanit"
            android:text="สแกน QR จับคู่"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/lk_qr_instruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="58dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:background="@drawable/lk_qr_hint_background"
        android:fontFamily="@font/kanit"
        android:text="วาง QR จับคู่ร้านค้าให้อยู่ในกรอบ"
        android:textColor="#184B35"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:maxLines="2" />
    <TextView
        android:id="@+id/lk_qr_version_footer"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:background="#F4F8F5"
        android:fontFamily="@font/kanit"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="11sp"
        android:textColor="#537465"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

</FrameLayout>
