rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasRole(roles) { return signedIn() && profile().active == true && profile().role in roles; }
    function adminRole() { return hasRole(['owner', 'admin', 'super_admin']); }
    function cashierRole() { return hasRole(['owner', 'cashier', 'super_admin']); }
    function kitchenRole() { return hasRole(['owner', 'kitchen', 'super_admin']); }
    function staffRole() { return hasRole(['owner', 'admin', 'super_admin', 'cashier', 'kitchen']); }
    function superAdminRole() { return hasRole(['super_admin']); }
    function tenantMembershipPath(tenantId) { return /databases/$(database)/documents/tenants/$(tenantId)/memberships/$(request.auth.uid); }
    function tenantOwner(tenantId) { return signedIn() && (get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid || get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerEmail == request.auth.token.email); }
    function profileTenantMember(tenantId) { return signedIn() && profile().active == true && profile().tenantId == tenantId; }
    function tenantMember(tenantId) { return signedIn() && (tenantOwner(tenantId) || (exists(tenantMembershipPath(tenantId)) && get(tenantMembershipPath(tenantId)).data.active == true) || profileTenantMember(tenantId)); }
    function tenantHasRole(tenantId, roles) { return signedIn() && (tenantOwner(tenantId) || (exists(tenantMembershipPath(tenantId)) && get(tenantMembershipPath(tenantId)).data.active == true && get(tenantMembershipPath(tenantId)).data.role in roles) || (profileTenantMember(tenantId) && profile().role in roles)); }
    function tenantAdminRole(tenantId) { return superAdminRole() || tenantHasRole(tenantId, ['owner', 'admin', 'super_admin']); }
    function tenantCashierRole(tenantId) { return superAdminRole() || tenantHasRole(tenantId, ['owner', 'cashier', 'super_admin']); }
    function tenantKitchenRole(tenantId) { return superAdminRole() || tenantHasRole(tenantId, ['owner', 'kitchen', 'super_admin']); }
    function tenantStaffRole(tenantId) { return superAdminRole() || tenantHasRole(tenantId, ['owner', 'admin', 'super_admin', 'cashier', 'kitchen']); }
    function validOrderBase() { return request.resource.data.status == 'pending' && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 100 && request.resource.data.totalAmount is number && request.resource.data.totalAmount >= 0; }
    function validDeliveryOrder() { return validOrderBase() && request.resource.data.orderType == 'delivery' && request.resource.data.paymentStatus in ['unpaid', 'pending_verification']; }
    function validTakeawayOrder() { return validOrderBase() && request.resource.data.orderType == 'takeaway' && request.resource.data.queueNo is string && request.resource.data.pickupStatus == 'waiting' && request.resource.data.paymentStatus in ['unpaid', 'pending_verification'] && ((request.resource.data.customerName is string && request.resource.data.customerName.size() > 0) || (request.resource.data.customerPhone is string && request.resource.data.customerPhone.size() > 0)); }
    function validTableOrder() { return validOrderBase() && request.resource.data.tableCode is string && request.resource.data.tableToken is string && get(/databases/$(database)/documents/tables/$(request.resource.data.tableCode)).data.status == 'occupied' && get(/databases/$(database)/documents/tables/$(request.resource.data.tableCode)).data.orderToken == request.resource.data.tableToken; }
    function activeTableOrder() { return resource.data.tableCode is string && resource.data.tableToken is string && get(/databases/$(database)/documents/tables/$(resource.data.tableCode)).data.status == 'occupied' && get(/databases/$(database)/documents/tables/$(resource.data.tableCode)).data.orderToken == resource.data.tableToken; }
    function tenantPayloadMatches(tenantId) { return request.resource.data.tenantId == tenantId || request.resource.data.shopId == tenantId; }
    function tenantResourceMatches(tenantId) { return resource.data.tenantId == tenantId || resource.data.shopId == tenantId; }
    function retailTenantWrite(tenantId) { return signedIn() && tenantHasRole(tenantId, ['owner', 'admin', 'manager', 'cashier', 'super_admin']) && tenantPayloadMatches(tenantId); }
    function retailStockUpdate(tenantId) { return retailTenantWrite(tenantId) && tenantResourceMatches(tenantId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'tenantId', 'shopId', 'updatedAt', 'updatedAtServer']); }
    function validPosStockUpdate(tenantId) { return signedIn() && tenantPayloadMatches(tenantId) && tenantResourceMatches(tenantId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'tenantId', 'shopId', 'updatedAt', 'updatedAtServer']); }
    function validTenantTableOrder(tenantId) { return validOrderBase() && tenantPayloadMatches(tenantId) && request.resource.data.tableCode is string && request.resource.data.tableToken is string && get(/databases/$(database)/documents/tenants/$(tenantId)/tables/$(request.resource.data.tableCode)).data.status == 'occupied' && get(/databases/$(database)/documents/tenants/$(tenantId)/tables/$(request.resource.data.tableCode)).data.orderToken == request.resource.data.tableToken; }
    function activeTenantTableOrder(tenantId) { return resource.data.tableCode is string && resource.data.tableToken is string && get(/databases/$(database)/documents/tenants/$(tenantId)/tables/$(resource.data.tableCode)).data.status == 'occupied' && get(/databases/$(database)/documents/tenants/$(tenantId)/tables/$(resource.data.tableCode)).data.orderToken == resource.data.tableToken; }
    function validPublicTenantTakeaway(tenantId) { return tenantPayloadMatches(tenantId) && validTakeawayOrder(); }
    function validPublicTenantDelivery(tenantId) { return tenantPayloadMatches(tenantId) && validDeliveryOrder(); }
    function validRetailSale(tenantId) { return tenantPayloadMatches(tenantId) && request.resource.data.status == 'completed' && request.resource.data.channel == 'retail-pos' && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 100 && request.resource.data.totalQty is number && request.resource.data.totalQty > 0 && request.resource.data.totalAmount is number && request.resource.data.totalAmount >= 0 && (!('cashierId' in request.resource.data) || request.resource.data.cashierId == request.auth.uid); }
    function validPosSale(tenantId) { return signedIn() && validRetailSale(tenantId); }
    function validStockMovement(tenantId) { return tenantPayloadMatches(tenantId) && request.resource.data.productId is string && request.resource.data.type in ['sale', 'purchase', 'adjustment', 'return'] && request.resource.data.direction in ['in', 'out'] && request.resource.data.qty is number && request.resource.data.qty > 0 && request.resource.data.createdBy == request.auth.uid; }
    function validPosSaleMovement(tenantId) { return signedIn() && validStockMovement(tenantId) && request.resource.data.type == 'sale' && request.resource.data.direction == 'out'; }
    function validPosSaleItem(tenantId) { return signedIn() && tenantPayloadMatches(tenantId) && request.resource.data.saleId is string && request.resource.data.productId is string && request.resource.data.channel == 'retail-pos' && request.resource.data.orderType == 'pos' && request.resource.data.qty is number && request.resource.data.qty > 0; }
    function validPosCounter(tenantId) { return signedIn() && tenantPayloadMatches(tenantId) && request.resource.data.prefix == 'POS' && request.resource.data.dateKey is string && request.resource.data.current is number && request.resource.data.current >= 0; }
    function validTaxCounter(tenantId) { return retailTenantWrite(tenantId) && request.resource.data.prefix == 'TAX' && request.resource.data.dateKey is string && request.resource.data.current is number && request.resource.data.current >= 0; }
    function validPosRunningNumber(tenantId) { return signedIn() && tenantPayloadMatches(tenantId) && request.resource.data.documentType == 'SALE' && request.resource.data.prefix == 'POS' && request.resource.data.documentId is string && request.resource.data.documentNumber is string && request.resource.data.running is number && request.resource.data.running > 0 && request.resource.data.status == 'reserved'; }
    function validTaxRunningNumber(tenantId) { return retailTenantWrite(tenantId) && request.resource.data.documentType == 'TAX' && request.resource.data.documentCollection == 'taxInvoices' && request.resource.data.prefix == 'TAX' && request.resource.data.documentId is string && request.resource.data.documentNumber is string && request.resource.data.running is number && request.resource.data.running > 0 && request.resource.data.status == 'reserved'; }
    function validTakeawayCounter(tenantId) { return tenantPayloadMatches(tenantId) && request.resource.data.counterType == 'takeaway' && request.resource.data.dateKey is string && request.resource.data.current is number && request.resource.data.current >= 0 && request.resource.data.lastQueueNo is string; }
    function validPosDailySummary(tenantId) { return signedIn() && tenantPayloadMatches(tenantId) && request.resource.data.dateKey is string && request.resource.data.channel == 'retail-pos' && request.resource.data.totalAmount is number && request.resource.data.billCount is number; }
    function validPosSyncQueue(tenantId) { return signedIn() && tenantPayloadMatches(tenantId) && request.resource.data.saleId is string && request.resource.data.channel == 'retail-pos' && request.resource.data.orderType == 'pos' && request.resource.data.syncStatus in ['pending', 'syncing', 'synced', 'failed', 'conflict']; }
    function validPosAuditLog(tenantId) { return signedIn() && tenantPayloadMatches(tenantId) && request.resource.data.action is string && request.resource.data.createdBy == request.auth.uid; }
    function validRetailCustomer(tenantId) { return tenantPayloadMatches(tenantId) && request.resource.data.id is string && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 && (!('points' in request.resource.data) || (request.resource.data.points is number && request.resource.data.points >= 0)); }
    function validRetailSaleEnrichment(tenantId) { return tenantPayloadMatches(tenantId) && tenantResourceMatches(tenantId) && resource.data.channel == 'retail-pos' && resource.data.status == 'completed' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerId','customerCode','customerName','customerPhone','loyalty','shopId','tenantId','updatedAt','updatedAtServer']); }
    function validLoyaltyLedgerEntry(tenantId) { return tenantPayloadMatches(tenantId) && request.resource.data.id is string && request.resource.data.customerId is string && request.resource.data.saleId is string && request.resource.data.pointsUsed is number && request.resource.data.pointsUsed >= 0 && request.resource.data.pointsEarned is number && request.resource.data.pointsEarned >= 0 && request.resource.data.balanceBefore is number && request.resource.data.balanceBefore >= 0 && request.resource.data.balanceAfter is number && request.resource.data.balanceAfter >= 0 && request.resource.data.createdBy == request.auth.uid; }
    function validHeldBill(tenantId) { return tenantPayloadMatches(tenantId) && request.resource.data.id is string && request.resource.data.status == 'held' && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 100 && request.resource.data.total is number && request.resource.data.total >= 0 && request.resource.data.createdBy == request.auth.uid; }
    function validRetailShift(tenantId) { return tenantPayloadMatches(tenantId) && request.resource.data.id is string && request.resource.data.cashierName is string && request.resource.data.terminalCode is string && request.resource.data.openingCash is number && request.resource.data.openingCash >= 0 && request.resource.data.status in ['open', 'closed'] && request.resource.data.createdBy == request.auth.uid && (request.resource.data.status == 'open' || request.resource.data.closedBy == request.auth.uid); }
    function validRetailReturn(tenantId) { return tenantPayloadMatches(tenantId) && request.resource.data.id is string && request.resource.data.saleId is string && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 100 && request.resource.data.refundTotal is number && request.resource.data.refundTotal >= 0 && request.resource.data.createdBy == request.auth.uid; }
    function validRetailReturnSaleUpdate(tenantId) { return tenantPayloadMatches(tenantId) && tenantResourceMatches(tenantId) && resource.data.channel == 'retail-pos' && resource.data.status == 'completed' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returns','refundTotal','loyalty','updatedAt','updatedAtServer']); }
    function posSaleDocPath(tenantId, saleId) { return /databases/$(database)/documents/tenants/$(tenantId)/sales/$(saleId); }
    function canReadPosSaleForTransaction(tenantId, saleId) { return signedIn() && (!exists(posSaleDocPath(tenantId, saleId)) || tenantMember(tenantId)); }
    function validOwnNotificationToken(tenantId, tokenId) {
      return signedIn()
        && tenantMember(tenantId)
        && tokenId.matches(request.auth.uid + '_.*')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tenantId == tenantId
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() > 0
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.role is string
        && tenantHasRole(tenantId, [request.resource.data.role])
        && request.resource.data.active is bool
        && request.resource.data.keys().hasOnly(['token', 'uid', 'email', 'role', 'tenantId', 'deviceId', 'userAgent', 'active', 'updatedAt', 'invalidatedAt', 'errorCode']);
    }
    function validPublicWaitingQueue() {
      return request.resource.data.publicToken is string
        && request.resource.data.publicToken.size() >= 20
        && request.resource.data.tenantId is string
        && request.resource.data.queueNumber is string
        && request.resource.data.partySize is number
        && request.resource.data.partySize > 0
        && request.resource.data.status in ['waiting', 'called', 'seated', 'skipped', 'cancelled'];
    }


    function waitingQueueOrderStaff(tenantId) {
      return signedIn()
        && tenantHasRole(
          tenantId,
          ['owner', 'admin', 'manager', 'cashier', 'super_admin']
        );
    }

    function validWaitingQueueDraftOrder(orderId) {
      return request.resource.data.get('tenantId', '') is string
        && waitingQueueOrderStaff(request.resource.data.get('tenantId', ''))
        && request.resource.data.get('waitingQueueId', '') is string
        && request.resource.data.get('waitingQueueId', '').size() > 0
        && orderId == 'order-wq-' + request.resource.data.get('waitingQueueId', '')
        && request.resource.data.get('id', '') == orderId
        && request.resource.data.get('orderId', '') == orderId
        && request.resource.data.get('orderType', '') == 'dine_in'
        && request.resource.data.get('status', '') == 'open'
        && request.resource.data.get('paymentStatus', '') == 'unpaid'
        && request.resource.data.get('items', []) is list
        && request.resource.data.get('items', []).size() == 0
        && request.resource.data.get('subtotal', -1) == 0
        && request.resource.data.get('total', -1) == 0
        && request.resource.data.get('createdBy', '') == request.auth.uid;
    }

    function validWaitingQueueDraftOrderUpdate(orderId) {
      return validWaitingQueueDraftOrder(orderId)
        && resource.data.get('tenantId', '') ==
          request.resource.data.get('tenantId', '')
        && resource.data.get('waitingQueueId', '') ==
          request.resource.data.get('waitingQueueId', '');
    }

    function validWaitingQueueTableOccupy() {
      return request.resource.data.get('tenantId', '') is string
        && waitingQueueOrderStaff(request.resource.data.get('tenantId', ''))
        && (
          resource.data.get('tenantId', '') == ''
          || resource.data.get('tenantId', '') ==
            request.resource.data.get('tenantId', '')
        )
        && request.resource.data.get('waitingQueueId', '') is string
        && request.resource.data.get('waitingQueueId', '').size() > 0
        && request.resource.data.get('status', '') == 'occupied'
        && request.resource.data.get('orderId', '') ==
          'order-wq-' + request.resource.data.get('waitingQueueId', '')
        && request.resource.data.get('orderToken', '') is string
        && request.resource.data.get('orderToken', '').size() >= 16
        && request.resource.data.get('currentRound', -1) is int
        && request.resource.data.get('currentRound', -1) >= 0
        && request.resource.data.get('orderIds', []) is list
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'tenantId',
          'status',
          'tableStatus',
          'occupied',
          'isOccupied',
          'available',
          'isAvailable',
          'activeOrderId',
          'currentOrderId',
          'orderId',
          'isOpen',
          'orderToken',
          'sessionStartedAt',
          'currentRound',
          'orderIds',
          'waitingQueueId',
          'waitingQueueNumber',
          'partySize',
          'occupiedAt',
          'occupiedAtMs',
          'updatedAt',
          'updatedAtMs'
        ]);
    }

    match /menus/{menuId} { allow read: if true; allow create, update, delete: if adminRole(); }
    match /settings/{settingId} { allow read: if true; allow create, update, delete: if adminRole(); }
    match /tables/{tableId} { allow read: if true; allow create, delete: if adminRole(); allow update: if adminRole() || cashierRole() || validWaitingQueueTableOccupy() || (kitchenRole() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'orderToken', 'sessionStartedAt', 'currentRound', 'orderIds', 'updatedAt', 'tenantId', 'shopId']) && resource.data.status == 'occupied' && request.resource.data.status == 'available' && request.resource.data.orderToken == '') || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentRound', 'orderIds', 'updatedAt']) && resource.data.status == 'occupied' && request.resource.data.orderToken == resource.data.orderToken && request.resource.data.orderIds is list); }
    match /orders/{orderId} { allow get: if true; allow list: if staffRole() || activeTableOrder(); allow create: if validDeliveryOrder() || validTableOrder() || validTakeawayOrder() || validWaitingQueueDraftOrder(orderId); allow update: if cashierRole() || kitchenRole() || adminRole() || validWaitingQueueDraftOrderUpdate(orderId); allow delete: if superAdminRole(); }
    match /customerProfiles/{userId} { allow read, create, update, delete: if signedIn() && request.auth.uid == userId && (request.method == 'delete' || (request.resource.data.addresses is list && request.resource.data.addresses.size() <= 5)); }
    match /deliveryCustomers/{customerId} { allow read, write: if adminRole(); }

    // PUBLIC_CONTACT_CENTER_20260803_005
    match /platformSettings/{settingId} {
      allow get: if settingId == 'publicContact';
      allow list: if false;

      allow create, update: if
        settingId == 'publicContact'
        && superAdminRole()
        && request.resource.data.keys().hasOnly([
          'id',
          'tenantId',
          'enabled',
          'heading',
          'description',
          'phoneEnabled',
          'phoneLabel',
          'phoneNumber',
          'lineEnabled',
          'lineLabel',
          'lineUrl',
          'messengerEnabled',
          'messengerLabel',
          'messengerUrl',
          'emailEnabled',
          'emailLabel',
          'email',
          'updatedBy',
          'updatedByEmail',
          'updatedAt',
          'updatedAtMs'
        ])
        && request.resource.data.get('id', '') == 'publicContact'
        && request.resource.data.get('tenantId', '') == '__platform__'
        && request.resource.data.get('enabled', false) is bool
        && request.resource.data.get('heading', '') is string
        && request.resource.data.get('heading', '').size() > 0
        && request.resource.data.get('heading', '').size() <= 80
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() <= 240
        && request.resource.data.get('phoneEnabled', false) is bool
        && request.resource.data.get('phoneLabel', '') is string
        && request.resource.data.get('phoneLabel', '').size() <= 60
        && request.resource.data.get('phoneNumber', '') is string
        && request.resource.data.get('phoneNumber', '').size() <= 40
        && request.resource.data.get('lineEnabled', false) is bool
        && request.resource.data.get('lineLabel', '') is string
        && request.resource.data.get('lineLabel', '').size() <= 60
        && request.resource.data.get('lineUrl', '') is string
        && request.resource.data.get('lineUrl', '').size() <= 500
        && request.resource.data.get('messengerEnabled', false) is bool
        && request.resource.data.get('messengerLabel', '') is string
        && request.resource.data.get('messengerLabel', '').size() <= 60
        && request.resource.data.get('messengerUrl', '') is string
        && request.resource.data.get('messengerUrl', '').size() <= 500
        && request.resource.data.get('emailEnabled', false) is bool
        && request.resource.data.get('emailLabel', '') is string
        && request.resource.data.get('emailLabel', '').size() <= 60
        && request.resource.data.get('email', '') is string
        && request.resource.data.get('email', '').size() <= 160
        && request.resource.data.get('updatedBy', '') == request.auth.uid
        && request.resource.data.get('updatedByEmail', '') is string
        && request.resource.data.get('updatedByEmail', '').size() <= 160
        && request.resource.data.get('updatedAtMs', 0) is int
        && request.resource.data.get('updatedAtMs', 0) > 0;

      allow delete: if false;
    }

    // GOOGLE_CUSTOMER_LOGIN_SETTINGS_20260903_001
    match /platformSettings/{settingId} {
      allow get: if settingId == 'googleCustomerLogin';
      allow list: if false;
      allow create, update: if
        settingId == 'googleCustomerLogin'
        && superAdminRole()
        && request.resource.data.keys().hasOnly([
          'id', 'tenantId', 'enabled', 'clientId', 'tokenTtlDays',
          'updatedBy', 'updatedByEmail', 'updatedAt', 'updatedAtMs'
        ])
        && request.resource.data.get('id', '') == 'googleCustomerLogin'
        && request.resource.data.get('tenantId', '') == '__platform__'
        && request.resource.data.get('enabled', false) is bool
        && request.resource.data.get('clientId', '') is string
        && request.resource.data.get('clientId', '').size() <= 255
        && request.resource.data.get('tokenTtlDays', 30) is int
        && request.resource.data.get('tokenTtlDays', 30) >= 1
        && request.resource.data.get('tokenTtlDays', 30) <= 90
        && request.resource.data.get('updatedBy', '') == request.auth.uid
        && request.resource.data.get('updatedByEmail', '') is string
        && request.resource.data.get('updatedByEmail', '').size() <= 160
        && request.resource.data.get('updatedAtMs', 0) is int
        && request.resource.data.get('updatedAtMs', 0) > 0;
      allow delete: if false;
    }

    match /users/{userId} { allow read: if signedIn() && (request.auth.uid == userId || superAdminRole()); allow create, update, delete: if superAdminRole(); }
    match /tenantSlugs/{slug} { allow read: if true; allow write: if superAdminRole(); }
    match /publicWaitingQueues/{publicToken} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn()
        && publicToken == request.resource.data.publicToken
        && tenantHasRole(request.resource.data.tenantId, ['owner', 'admin', 'manager', 'cashier', 'super_admin'])
        && validPublicWaitingQueue();
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow read: if true; allow create, update, delete: if superAdminRole();
      match /menus/{menuId} { allow read: if true; allow create, update, delete: if tenantAdminRole(tenantId); }
      match /settings/{settingId} { allow read: if true; allow create, update, delete: if tenantAdminRole(tenantId); }
      match /products/{productId} { allow read: if true; allow create: if tenantAdminRole(tenantId) && tenantPayloadMatches(tenantId) && ((!('importedFromExcel' in request.resource.data) && !('importedFromCatalog' in request.resource.data)) || tenantOwner(tenantId)); allow update: if (tenantAdminRole(tenantId) && tenantPayloadMatches(tenantId) && tenantResourceMatches(tenantId)) || retailStockUpdate(tenantId) || validPosStockUpdate(tenantId); allow delete: if tenantAdminRole(tenantId) && tenantResourceMatches(tenantId); }
      match /categories/{categoryId} { allow read: if true; allow create, update: if tenantAdminRole(tenantId) && tenantPayloadMatches(tenantId); allow delete: if tenantAdminRole(tenantId) && tenantResourceMatches(tenantId); }
      match /sales/{saleId} { allow get: if tenantMember(tenantId) || canReadPosSaleForTransaction(tenantId, saleId); allow list: if tenantMember(tenantId); allow create: if (retailTenantWrite(tenantId) && validRetailSale(tenantId)) || validPosSale(tenantId); allow update: if (tenantAdminRole(tenantId) && tenantResourceMatches(tenantId)) || (retailTenantWrite(tenantId) && validRetailSaleEnrichment(tenantId)) || (retailTenantWrite(tenantId) && validRetailReturnSaleUpdate(tenantId)); allow delete: if tenantAdminRole(tenantId) && tenantResourceMatches(tenantId); }
      match /saleItems/{itemId} { allow read: if tenantMember(tenantId); allow create: if validPosSaleItem(tenantId); allow update, delete: if false; }
      match /stockMovements/{movementId} { allow read: if tenantMember(tenantId); allow create: if (retailTenantWrite(tenantId) && validStockMovement(tenantId)) || validPosSaleMovement(tenantId); allow update, delete: if false; }
      match /counters/{counterId} { allow read: if signedIn() || counterId.matches('takeaway_.*'); allow create, update: if validPosCounter(tenantId) || validTaxCounter(tenantId) || validTakeawayCounter(tenantId); allow delete: if false; }
      match /runningNumbers/{runningNumberId} { allow read: if signedIn(); allow create, update: if validPosRunningNumber(tenantId) || validTaxRunningNumber(tenantId); allow delete: if false; }
      match /dailySummary/{summaryId} { allow read: if tenantMember(tenantId); allow create, update: if validPosDailySummary(tenantId); allow delete: if false; }
      match /syncQueue/{queueId} { allow read: if signedIn(); allow create, update: if validPosSyncQueue(tenantId); allow delete: if false; }
      match /auditLogs/{auditId} { allow read: if tenantAdminRole(tenantId); allow create: if validPosAuditLog(tenantId); allow update, delete: if false; }
      match /customers/{customerId} { allow read: if tenantMember(tenantId); allow create, update: if retailTenantWrite(tenantId) && validRetailCustomer(tenantId); allow delete: if tenantAdminRole(tenantId) && tenantResourceMatches(tenantId); }
      match /loyaltyLedger/{entryId} { allow read: if tenantMember(tenantId); allow create: if retailTenantWrite(tenantId) && validLoyaltyLedgerEntry(tenantId); allow update, delete: if false; }
      match /customerDisplays/{displayId} { allow read: if tenantMember(tenantId); allow create, update: if retailTenantWrite(tenantId) && tenantPayloadMatches(tenantId); allow delete: if tenantAdminRole(tenantId) && tenantResourceMatches(tenantId); }
      match /heldBills/{heldBillId} { allow read: if tenantMember(tenantId); allow create, update: if retailTenantWrite(tenantId) && validHeldBill(tenantId); allow delete: if tenantHasRole(tenantId, ['owner', 'admin', 'manager', 'cashier', 'super_admin']) && tenantResourceMatches(tenantId); }
      match /shifts/{shiftId} { allow read: if tenantMember(tenantId); allow create: if retailTenantWrite(tenantId) && validRetailShift(tenantId); allow update: if retailTenantWrite(tenantId) && tenantResourceMatches(tenantId) && request.resource.data.id == resource.data.id && validRetailShift(tenantId); allow delete: if false; }
      match /returns/{returnId} { allow read: if tenantMember(tenantId); allow create: if retailTenantWrite(tenantId) && validRetailReturn(tenantId); allow update, delete: if false; }
      match /taxInvoices/{invoiceId} { allow read: if tenantMember(tenantId); allow create: if retailTenantWrite(tenantId) && tenantPayloadMatches(tenantId); allow update: if retailTenantWrite(tenantId) && tenantPayloadMatches(tenantId) && tenantResourceMatches(tenantId); allow delete: if false; }
      match /taxBuyerProfiles/{profileId} { allow read: if tenantMember(tenantId); allow create: if retailTenantWrite(tenantId) && tenantPayloadMatches(tenantId); allow update: if retailTenantWrite(tenantId) && tenantPayloadMatches(tenantId) && tenantResourceMatches(tenantId); allow delete: if signedIn() && tenantHasRole(tenantId, ['owner', 'admin', 'manager', 'cashier', 'super_admin']) && tenantResourceMatches(tenantId); }
      match /tables/{tableId} { allow read: if true; allow create, delete: if tenantAdminRole(tenantId); allow update: if tenantAdminRole(tenantId) || tenantCashierRole(tenantId) || tenantHasRole(tenantId, ['manager']) || validWaitingQueueTableOccupy() || (tenantKitchenRole(tenantId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'orderToken', 'sessionStartedAt', 'currentRound', 'orderIds', 'updatedAt', 'tenantId', 'shopId']) && resource.data.status == 'occupied' && request.resource.data.status == 'available' && request.resource.data.orderToken == '') || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentRound', 'orderIds', 'updatedAt', 'tenantId', 'shopId']) && resource.data.status == 'occupied' && request.resource.data.orderToken == resource.data.orderToken && request.resource.data.orderIds is list); }
      match /waitingQueues/{queueId} { allow read, create, update: if tenantHasRole(tenantId, ['owner', 'admin', 'manager', 'cashier', 'super_admin']) && (request.method == 'get' || request.method == 'list' || tenantPayloadMatches(tenantId)); allow delete: if false; }
      match /orders/{orderId} { allow get: if true; allow list: if tenantStaffRole(tenantId) || activeTenantTableOrder(tenantId); allow create: if superAdminRole() || validPublicTenantDelivery(tenantId) || validPublicTenantTakeaway(tenantId) || validTenantTableOrder(tenantId); allow update: if tenantCashierRole(tenantId) || tenantKitchenRole(tenantId) || tenantAdminRole(tenantId); allow delete: if superAdminRole() || tenantHasRole(tenantId, ['owner', 'super_admin']); }
      match /customerProfiles/{userId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.get('tenantId', '') == tenantId
          && request.resource.data.get('addresses', []) is list
          && request.resource.data.get('addresses', []).size() <= 5;
      }
      match /deliveryCustomers/{customerId} { allow read, write: if tenantAdminRole(tenantId); }
      match /notificationTokens/{tokenId} {
        allow get: if signedIn() && resource.data.uid == request.auth.uid && resource.data.tenantId == tenantId;
        allow list: if false;
        allow create, update: if validOwnNotificationToken(tenantId, tokenId);
        allow delete: if false;
      }
      match /memberships/{userId} { allow read: if signedIn() && (request.auth.uid == userId || superAdminRole() || tenantAdminRole(tenantId)); allow create, update, delete: if superAdminRole(); }
    }
    /* WAITING_QUEUE_MVP_RULES_START */
    function wqTenantFromMap(data) {
      return data.get('tenantId', data.get('activeTenantId', data.get('shopId', data.get('storeId', ''))));
    }

    function wqMapHasTenant(data, tenantId) {
      return (
        wqTenantFromMap(data) == tenantId ||
        tenantId in data.get('tenantIds', []) ||
        tenantId in data.get('shopIds', []) ||
        tenantId in data.get('storeIds', [])
      );
    }

    function wqAllowedStaffRole(role) {
      return role in ['owner', 'admin', 'manager', 'cashier', 'super_admin'];
    }

    function wqUserProfileMember(tenantId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('active', true) == true
        && wqAllowedStaffRole(
          get(/databases/$(database)/documents/users/$(request.auth.uid))
            .data.get('role', '')
        )
        && wqMapHasTenant(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data,
          tenantId
        );
    }

    function wqMembershipMember(tenantId) {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/tenants/$(tenantId)/memberships/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/tenants/$(tenantId)/memberships/$(request.auth.uid)
        ).data.get('active', true) == true
        && wqAllowedStaffRole(
          get(
            /databases/$(database)/documents/tenants/$(tenantId)/memberships/$(request.auth.uid)
          ).data.get('role', '')
        );
    }

    function wqTenantOwnerMember(tenantId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/tenants/$(tenantId))
        && (
          get(/databases/$(database)/documents/tenants/$(tenantId))
            .data.get('ownerUid', '') == request.auth.uid
          || (
            request.auth.token.get('email', '') != ''
            && get(/databases/$(database)/documents/tenants/$(tenantId))
              .data.get('ownerEmail', '') == request.auth.token.get('email', '')
          )
        );
    }

    function wqClaimMember(tenantId) {
      return request.auth != null
        && wqAllowedStaffRole(request.auth.token.get('role', ''))
        && (
          request.auth.token.get('tenantId', '') == tenantId
          || request.auth.token.get('activeTenantId', '') == tenantId
          || request.auth.token.get('shopId', '') == tenantId
          || request.auth.token.get('storeId', '') == tenantId
          || tenantId in request.auth.token.get('tenantIds', [])
        );
    }

    function wqTenantMember(tenantId) {
      return request.auth != null && (
        request.auth.token.get('super_admin', false) == true
        || request.auth.token.get('role', '') == 'super_admin'
        || wqUserProfileMember(tenantId)
        || wqMembershipMember(tenantId)
        || wqTenantOwnerMember(tenantId)
        || wqClaimMember(tenantId)
      );
    }

    function wqValidStatus(status) {
      return status in [
        'waiting',
        'called',
        'acknowledged',
        'preparing_table',
        'seated',
        'deferred',
        'no_show',
        'cancelled'
      ];
    }

    function wqPublicHasNoPii(data) {
      return !data.keys().hasAny([
        'customerName',
        'phone',
        'phoneMasked',
        'phoneHash',
        'specialNote',
        'createdByName',
        'actorName',
        'actorEmail'
      ]);
    }

    function wqBoardHasNoPiiOrControlToken(data) {
      return wqPublicHasNoPii(data) && !data.keys().hasAny([
        'token',
        'publicToken',
        'customerResponse',
        'customerResponseAtMs'
      ]);
    }

    function wqExistingTenantCompatible(data, tenantId) {
      return data.get('tenantId', '') == ''
        || data.get('tenantId', '') == tenantId;
    }

    match /waitingQueues/{waitingQueueId} {
      allow get: if request.auth != null && (
        !exists(
          /databases/$(database)/documents/waitingQueues/$(waitingQueueId)
        )
        || wqTenantMember(resource.data.tenantId)
      );
      allow list: if wqTenantMember(resource.data.tenantId);
      allow create: if
        wqTenantMember(request.resource.data.tenantId)
        && request.resource.data.get('waitingQueueId', '') == waitingQueueId
        && request.resource.data.get('id', '') == waitingQueueId
        && request.resource.data.get('partySize', 0) >= 1
        && request.resource.data.get('partySize', 0) <= 99
        && wqValidStatus(request.resource.data.get('status', ''))
        && request.resource.data.get('deleted', false) == false;
      allow update: if
        wqTenantMember(request.resource.data.get('tenantId', ''))
        && wqExistingTenantCompatible(
          resource.data,
          request.resource.data.get('tenantId', '')
        )
        && request.resource.data.get('waitingQueueId', '') == waitingQueueId
        && request.resource.data.get('id', '') == waitingQueueId
        && resource.data.get('waitingQueueId', waitingQueueId) == waitingQueueId
        && resource.data.get('id', waitingQueueId) == waitingQueueId
        && request.resource.data.get('version', 0) >= resource.data.get('version', 0)
        && wqValidStatus(request.resource.data.get('status', ''))
        && request.resource.data.get('deleted', false) == false;
      allow delete: if false;
    }

    match /waitingQueuePublic/{publicToken} {
      allow get: if true;
      allow list: if wqTenantMember(resource.data.tenantId);
      allow create: if
        wqTenantMember(request.resource.data.tenantId)
        && request.resource.data.get('token', '') == publicToken
        && wqPublicHasNoPii(request.resource.data);
      allow update: if (
        wqTenantMember(request.resource.data.get('tenantId', ''))
        && wqExistingTenantCompatible(
          resource.data,
          request.resource.data.get('tenantId', '')
        )
        && request.resource.data.get('token', '') == publicToken
        && resource.data.get('token', publicToken) == publicToken
        && request.resource.data.get('waitingQueueId', '') != ''
        && request.resource.data.get('waitingQueueId', '') ==
          resource.data.get(
            'waitingQueueId',
            request.resource.data.get('waitingQueueId', '')
          )
        && wqPublicHasNoPii(request.resource.data)
      ) || (
        resource.data.get('active', false) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customerResponse',
          'customerResponseAtMs',
          'updatedAt',
          'updatedAtMs'
        ])
        && request.resource.data.get('customerResponse', '') in [
          'on_the_way',
          'cancel_requested'
        ]
        && request.resource.data.get('customerResponseAtMs', 0) is int
        && request.resource.data.get('updatedAtMs', 0) is int
        && request.resource.data.get('updatedAtMs', 0) >=
          resource.data.get('updatedAtMs', 0)
      );
      allow delete: if false;
    }

    match /waitingQueueBoard/{waitingQueueId} {
      allow get, list: if true;
      allow create: if
        wqTenantMember(request.resource.data.tenantId)
        && request.resource.data.get('id', '') == waitingQueueId
        && request.resource.data.get('waitingQueueId', '') == waitingQueueId
        && wqValidStatus(request.resource.data.get('status', ''))
        && wqBoardHasNoPiiOrControlToken(request.resource.data);
      allow update: if
        wqTenantMember(request.resource.data.get('tenantId', ''))
        && wqExistingTenantCompatible(
          resource.data,
          request.resource.data.get('tenantId', '')
        )
        && request.resource.data.get('id', '') == waitingQueueId
        && request.resource.data.get('waitingQueueId', '') == waitingQueueId
        && resource.data.get('id', waitingQueueId) == waitingQueueId
        && resource.data.get('waitingQueueId', waitingQueueId) == waitingQueueId
        && wqValidStatus(request.resource.data.get('status', ''))
        && wqBoardHasNoPiiOrControlToken(request.resource.data);
      allow delete: if false;
    }

    match /waitingQueueAudits/{auditId} {
      allow get, list: if wqTenantMember(resource.data.tenantId);
      allow create: if
        wqTenantMember(request.resource.data.tenantId) &&
        request.resource.data.get('id', '') == auditId &&
        request.resource.data.get('waitingQueueId', '') != '';
      allow update, delete: if false;
    }

    match /waitingQueueCounters/{counterId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if wqTenantMember(request.resource.data.tenantId);
      allow delete: if false;
    }

    match /waitingQueueNumberLeases/{leaseId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && wqTenantMember(resource.data.tenantId);
      allow create, update: if wqTenantMember(request.resource.data.tenantId);
      allow delete: if false;
    }

    match /waitingQueueNumbers/{numberId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if wqTenantMember(request.resource.data.tenantId);
      allow update: if
        wqTenantMember(resource.data.tenantId)
        && request.resource.data.get('tenantId', '') ==
          resource.data.get('tenantId', '')
        && request.resource.data.get('waitingQueueId', '') ==
          resource.data.get('waitingQueueId', '')
        && request.resource.data.get('queueNumber', '') ==
          resource.data.get('queueNumber', '');
      allow delete: if false;
    }


    match /waitingQueueOperations/{operationId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if
        wqTenantMember(request.resource.data.tenantId) &&
        request.resource.data.get('id', '') == operationId &&
        request.resource.data.get('waitingQueueId', '') != '';
      allow update, delete: if false;
    }

    match /waitingQueueDedupe/{dedupeId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if wqTenantMember(request.resource.data.tenantId);
      allow delete: if false;
    }
    /* WAITING_QUEUE_MVP_RULES_END */
  }
}
